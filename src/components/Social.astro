---
const { platform, username } = Astro.props;

const socialLinks = {
  twitter: {
    label: "Follow on Twitter",
    path: "M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
  },
  github: {
    label: "Visit GitHub profile",
    path: "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.22.48-2.69-.94-2.69-.94-.36-.92-.89-1.16-.89-1.16-.73-.5.06-.49.06-.49.81.06 1.24.83 1.24.83.72 1.23 1.89.87 2.35.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
  },
  youtube: {
    label: "Subscribe on YouTube",
    path: "M15.8 4.8a2 2 0 0 0-1.4-1.4C13.2 3 8 3 8 3s-5.2 0-6.4.4A2 2 0 0 0 .2 4.8C0 6 0 8 0 8s0 2 .2 3.2a2 2 0 0 0 1.4 1.4C2.8 13 8 13 8 13s5.2 0 6.4-.4a2 2 0 0 0 1.4-1.4C16 10 16 8 16 8s0-2-.2-3.2zM6.4 10.2V5.8L10.6 8z"
  }
};

const social = socialLinks[platform];

---

{social && (
  <a
    href={`https://${platform === "twitter" ? "twitter" : platform === "github" ? "github" : "youtube"}.com/${username}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={social.label}
  >
    <svg
      viewBox="0 0 16 16"
      aria-hidden="true"
      width="32"
      height="32"
      fill="currentColor"
    >
      <path d={social.path} />
    </svg>
  </a>
)}
		